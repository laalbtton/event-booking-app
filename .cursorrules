  {/* Main content */}
  <div className="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    {/* Page content */}
  </div>
</div>
```

## SUPABASE BEST PRACTICES

### Row Level Security (RLS)
- **Always enable RLS**: `alter table [table] enable row level security`
- **Public read**: For events, venues (anyone can view)
- **User-specific**: Profiles, bookings (users can only see/edit their own)
- **Admin-only**: Admin tables, sensitive operations

**Admin transactions page:**
- `app/admin/transactions/page.tsx` reads from `credit_transactions` and embeds `profiles(full_name,email)`.
- If admins see *no rows* (or a permission error), ensure RLS policies allow admin `SELECT` on:
  - `credit_transactions`
  - `profiles` (for embedded reads)
- Migration in repo: `credit_transactions_admin_rls.sql`

**Common Policies:**
```sql
-- Users can view their own data
create policy "users_view_own_data" on profiles
  for select using (auth.uid() = id);

-- Users can update their own data
create policy "users_update_own_data" on profiles
  for update using (auth.uid() = id) with check (auth.uid() = id);

-- Anyone can view public data
create policy "anyone_can_view" on events
  for select to authenticated, anon using (true);

-- Only admins can manage
create policy "admins_only" on events
  for all using (
    exists (select 1 from admin_users where user_id = auth.uid())
  );
```

### Database Queries
**Pattern for fetching with relations:**
```typescript
const { data, error } = await supabase
  .from('bookings')
  .select(`
    *,
    events (*),
    profiles (full_name, email, avatar_url)
  `)
  .eq('user_id', userId)
  .order('created_at', { ascending: false })
```

**Always include error handling:**
```typescript
if (error) {
  console.error('Error:', error)
  throw error // or handle gracefully
}
```

**Use service role only on server:**
```typescript
// For client-side (app/)
import { supabase } from '@/lib/supabase'

// For server-side (app/api/)
import { createClient } from '@supabase/supabase-js'
const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY! // Has admin access
)
```

### Real-time Subscriptions (Future Feature)
```typescript
// Listen for new bookings
const channel = supabase
  .channel('bookings')
  .on('postgres_changes', 
    { event: 'INSERT', schema: 'public', table: 'bookings' },
    (payload) => {
      console.log('New booking:', payload.new)
    }
  )
  .subscribe()
```

## API ROUTES (app/api/)

### Pattern for API Routes:
```typescript
import { NextResponse } from 'next/server'
import { createClient } from '@supabase/supabase-js'

// Use service role for server-side operations
const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
)

export async function GET(request: Request) {
  try {
    // Your logic here
    
    return NextResponse.json({ success: true, data })
  } catch (error: any) {
    console.error('API error:', error)
    return NextResponse.json(
      { error: error.message },
      { status: 500 }
    )
  }
}
```

### Cron Job Routes:
- Secure with CRON_SECRET
- Use service role (not user auth)
- Log all operations
- Return summary JSON

**Pattern:**
```typescript
// Verify cron secret
const authHeader = request.headers.get('authorization')
if (authHeader !== `Bearer ${process.env.CRON_SECRET}`) {
  return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
}
```

## COMPONENT CREATION GUIDELINES

### When to Create a Component
- Used in 2+ places
- Complex logic that clutters page
- Reusable UI pattern (Avatar, VenueSelector)

### Component Pattern:
```typescript
// components/ComponentName.tsx
type ComponentNameProps = {
  prop1: string
  prop2?: number
  onAction?: () => void
}

export default function ComponentName({ prop1, prop2, onAction }: ComponentNameProps) {
  return (
    <div>
      {/* Component JSX */}
    </div>
  )
}
```

### Existing Reusable Components:
1. **Avatar** - User profile pictures with initials fallback
```tsx
   <Avatar src={user.avatar_url} name={user.full_name} size="md" />
```

2. **VenueSelector** - Venue dropdown for event creation
```tsx
   <VenueSelector
     value={locationData}
     onChange={(data) => setLocationData(data)}
     required
   />
```

## COMMON WORKFLOWS

### Adding a New Database Field

**Example: Adding "phone_number" to profiles**

1. **Database:**
```sql
alter table profiles add column phone_number text;
comment on column profiles.phone_number is 'User contact number';
```

2. **Types (lib/supabase.ts):**
```typescript
export type Profile = {
  // ... existing fields
  phone_number: string | null // NEW
}
```

3. **Update ALL profile displays:**
   - app/profile/page.tsx (edit form + display)
   - app/profile/[id]/page.tsx (public display, if public)
   - Consider: app/admin/users/page.tsx (admin view)

4. **Update queries** that fetch profiles (if needed)

5. **Test:**
   - Can edit in profile page
   - Saves to database
   - Shows correctly in all locations

### Adding a New Feature

**Example: Adding event categories**

1. **Plan the feature:**
   - What database tables/columns needed?
   - Where will it display?
   - What user actions?

2. **Database changes:**
   - Create tables/columns
   - Add RLS policies
   - Create triggers if needed

3. **Update types:**
   - lib/supabase.ts

4. **Create components** (if reusable):
   - components/CategorySelector.tsx

5. **Update pages:**
   - Admin: Add to create/edit form
   - User: Display in event lists, filter by category

6. **Test end-to-end**

7. **Deploy and monitor**

### Debugging Common Issues

**"Not showing on page X"**
→ Check if that page's query includes the new field
→ Check if component is using the new field
→ Check browser console for errors

**"TypeScript error"**
→ Update types in lib/supabase.ts
→ Restart TypeScript server (Cmd+Shift+P → Restart TS Server)

**"Database error"**
→ Check RLS policies (user may not have permission)
→ Check if column exists in database
→ Check Supabase logs

**"Not updating"**
→ Check if mutation is called
→ Check if error is caught and logged
→ Check if page refetches data after mutation

